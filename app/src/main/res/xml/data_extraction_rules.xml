<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- By specifying an include tag, ONLY the specified preference file is backed up to cloud.
             All internal files, databases, cache, and external storage are excluded by default. -->
        <include domain="sharedpref" path="repix_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Only migrate non-sensitive UI preferences during device-to-device transfer. -->
        <include domain="sharedpref" path="repix_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
